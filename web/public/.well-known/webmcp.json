{
  "schema_version": "1.0.0",
  "name": "Free LLM Models WebMCP",
  "description": "Expose site tools to AI agents via the browser using WebMCP.",
  "url": "https://free-llm-models.custats.info/.well-known/webmcp.html",
  "transport": "web-mcp",
  "tools": [
    {
      "name": "search_models",
      "description": "Search the free AI model catalog by query, provider, and modality.",
      "method": "GET",
      "endpoint": "/?q={query}&provider={provider}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "provider": { "type": "string" },
          "modality": { "type": "string" }
        }
      }
    },
    {
      "name": "get_model",
      "description": "Get details for a specific model",
      "method": "GET",
      "endpoint": "/model/{model_id}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": { "type": "string" }
        },
        "required": ["model_id"]
      }
    },
    {
      "name": "list_providers",
      "description": "List all providers with free models",
      "method": "GET",
      "endpoint": "/models/index.json",
      "inputSchema": { "type": "object", "properties": {} }
    }
  ]
}
