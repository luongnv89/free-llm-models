{
  "schema_version": "1.0.0",
  "name": "Free LLM Models MCP Server",
  "description": "Model catalog browsing and search via the Model Context Protocol.",
  "url": "https://luongnv.com/free-llm-models/.well-known/mcp.json",
  "transport": "sse",
  "capabilities": {
    "tools": {
      "list": [
        {
          "name": "search_models",
          "description": "Search the free AI model catalog.",
          "input_schema": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "provider": { "type": "string" },
              "modality": { "type": "string" },
              "context_length": { "type": "integer" }
            }
          }
        },
        {
          "name": "get_model",
          "description": "Get details for a specific model.",
          "input_schema": {
            "type": "object",
            "properties": {
              "model_id": { "type": "string" }
            },
            "required": ["model_id"]
          }
        },
        {
          "name": "list_providers",
          "description": "List all providers with free models.",
          "input_schema": { "type": "object", "properties": {} }
        }
      ]
    }
  }
}
