{
  "name": "openrouter-free-models",
  "version": "1.0.0",
  "description": "Fetch and list free models from OpenRouter API",
  "main": "get_openrouter_free_models.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node get_openrouter_free_models.js",
    "crossref": "node scripts/crossref-free-lists.js --fetch",
    "test": "node --test test/*.test.js",
    "test:smoke": "RUN_LIVE_SMOKE=1 node --test test/live-smoke.test.js",
    "build": "cd web && npm install --no-audit --no-fund && npm run build"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
