      "description": "Frequently asked questions."
    },
    {
      "uri": "/llms.txt",
      "rel": "service",
      "type": "text/plain",
      "title": "LLMs Text",
      "description": "Full-text site content for LLM consumption."
    },
    {
      "uri": "/",
      "rel": "self",
      "type": "application/json"
    },
    {
      "uri": "/",
      "rel": "http://www.iana.org/assignments/relation/origin",
      "type": "text/html"
    }
  ],
