{
  "serverInfo": {
    "name": "Free LLM Models MCP Server",
    "version": "1.0.0"
  },
  "description": "Model catalog browsing and search via the Model Context Protocol. Search free AI models, get model details, and list providers.",
  "url": "https://free-llm-models.custats.com/mcp",
  "endpoint": "https://free-llm-models.custats.com/mcp",
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://free-llm-models.custats.com/mcp"
  },
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": false
  },
  "tools": [
    {
      "name": "search_models",
      "description": "Search the free AI model catalog by query, provider, or capability.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Search query" },
          "provider": { "type": "string", "description": "Filter by provider" },
          "modality": { "type": "string", "description": "Filter by modality" },
          "context_length": { "type": "integer", "description": "Minimum context length" }
        }
      }
    },
    {
      "name": "get_model",
      "description": "Get details for a specific model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": { "type": "string", "description": "The model ID" }
        },
        "required": ["model_id"]
      }
    },
    {
      "name": "list_providers",
      "description": "List all providers with free models.",
      "inputSchema": { "type": "object", "properties": {} }
    }
  ]
}
