{
  "schema_version": "1.0.0",
  "name": "Free LLM Models API Catalog",
  "description": "Machine-readable API catalog for the Free LLM Models directory.",
  "apis": [
    {
      "name": "Full Model Catalog",
      "description": "Complete catalog of all free AI models with metadata.",
      "url": "/free_models.json",
      "method": "GET",
      "content_type": "application/json",
      "authentication": "none"
    },
    {
      "name": "Per-Provider Model Index",
      "description": "Provider-specific model listings with counts.",
      "url": "/models/index.json",
      "method": "GET",
      "content_type": "application/json",
      "authentication": "none"
    },
    {
      "name": "Model Details",
      "description": "Detailed information about a specific free AI model.",
      "url": "/model/{model_id}",
      "method": "GET",
      "content_type": "text/html",
      "authentication": "none"
    },
    {
      "name": "FAQ Content",
      "description": "Frequently asked questions.",
      "url": "/faq",
      "method": "GET",
      "content_type": "text/html",
      "authentication": "none"
    },
    {
      "name": "LLMs Text",
      "description": "Full-text site content for LLM consumption.",
      "url": "/llms.txt",
      "method": "GET",
      "content_type": "text/plain",
      "authentication": "none"
    }
  ],
  "homepage": "https://free-llm-models.vercel.app/",
  "documentation": "https://github.com/luongnv89/free-llm-models"
}
