# Optional. The public OpenRouter /models endpoint works without a key.
# Set this if you prefer authenticated requests or higher rate limits.
# OPENROUTER_API_KEY=

# Groq. The public /models endpoint requires a key; get one at
# https://console.groq.com/keys
# GROQ_API_KEY=

# Google AI Studio. The /v1beta/models endpoint requires a key; get one at
# https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=

# Cerebras. The /v1/models endpoint works best with a key; get one at
# https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# Mistral AI. The /v1/models endpoint works best with a key; get one at
# https://console.mistral.ai
# MISTRAL_API_KEY=

# GitHub Models. The /catalog/models endpoint requires a token; create a
# personal access token (classic) at https://github.com/settings/tokens
# GITHUB_TOKEN=

# Hugging Face Inference Providers (HF Router). The /v1/models endpoint works
# best with a token; create one at https://huggingface.co/settings/tokens
# HF_TOKEN=

# NVIDIA NIM. The /v1/models endpoint requires a key; get one at
# https://build.nvidia.com (NVIDIA's docs call this NVAPI_KEY; we use
# NVIDIA_API_KEY for consistency with other providers).
# NVIDIA_API_KEY=

# Optional. Comma-separated provider IDs to fetch (e.g. "openrouter,groq").
# Leave unset to fetch all configured providers.
# PROVIDERS=openrouter,groq

# Optional. Per-provider request timeout in milliseconds (default: 30000).
# PROVIDER_TIMEOUT_MS=30000
