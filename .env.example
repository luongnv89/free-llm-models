# Optional. The public OpenRouter /models endpoint works without a key.
# Set this if you prefer authenticated requests or higher rate limits.
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq. The public /models endpoint requires a key; get one at
# https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio. The /v1beta/models endpoint requires a key; get one at
# https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Cerebras. The /v1/models endpoint works best with a key; get one at
# https://cloud.cerebras.ai
# CEREBRAS_API_KEY=your_cerebras_api_key_here
